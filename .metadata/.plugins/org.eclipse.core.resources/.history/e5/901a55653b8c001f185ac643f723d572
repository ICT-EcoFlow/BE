package com.example.demo.controller;



import io.swagger.v3.oas.annotations.tags.Tag;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import com.example.demo.DTO.PhoneRequestDto;
import com.example.demo.DTO.UserResponseDTO2;
import com.example.demo.DTO.UserchergerDTO;
import com.example.demo.DTO.UserchergerPhoneRequestDto;
import com.example.demo.Entity.Phone;
import com.example.demo.Service.AuthService;
import com.example.demo.Service.PhoneService;
import com.example.demo.Service.StatCheckService;
import com.example.demo.Service.UserchergerService;

import java.util.Map;

@RestController
@RequestMapping("/api/auth")
@RequiredArgsConstructor
@Slf4j
@Tag(name = "핸드폰 인증", description = "JWT권한 없음. -없이 번호만 입력")
public class PhoneController {

    private final PhoneService phoneService;
    private final AuthService authService;
    private final StatCheckService statCheckService;
    @Autowired
    private UserchergerService userchergerService;
    @Autowired
    Phone phones;

    @PostMapping("/phonecheck")
    public ResponseEntity<?> phonecheck1(@RequestBody PhoneRequestDto phoneRequestDto) { // 'String' 제거
        phoneService.sendOne(phoneRequestDto.getPhone());
        phones.setPhoneNumber(phoneRequestDto.getPhone());
        System.out.println(phones.getPhoneNumber() + "받아옴");
        return ResponseEntity.ok(Map.of(
                "message", "인증 번호가 성공적으로 발송되었습니다.",
                "verifyCode", phones.getRand()
        ));
    }
    
    @PostMapping("/userchergerphone")
    public ResponseEntity<?> userchergerphone(@RequestBody UserchergerPhoneRequestDto userchergerphoneRequestDto) {
        UserResponseDTO2 userResponse = authService.getUserById(userchergerphoneRequestDto.getUsername());
        String userphone = userResponse.getPhone();
        System.out.println("유저폰:"+userphone);
        
        UserchergerDTO userCharger = userchergerService.getUserChargerById(userchergerphoneRequestDto.getId());  // 이 부분 확인
        String busicall = userCharger.getBusiCall();
        System.out.println("사업자폰:"+busicall);
        
        phoneService.sendOne2(busicall, userphone);
        phoneService.sendOne3(userphone);
        userchergerService.updateChargerStat(userchergerphoneRequestDto.getId());

        return ResponseEntity.ok(Map.of(
                "message", "예약이 완료되었습니다."
        ));
    }
    

    /**
     * 프론트에서 username과 stat id를 받아 처리하는 메서드
     */
    @PostMapping("/checkStat")
    public ResponseEntity<?> checkStat(@RequestBody UserchergerPhoneRequestDto userchergerPhoneRequestDto) {

        // username과 stat id 값을 서비스로 전달하여 처리
        boolean isStatUpdated = statCheckService.checkStatAndSendSms(userchergerPhoneRequestDto.getUsername(), userchergerPhoneRequestDto.getId());

        if (!isStatUpdated) {
            return ResponseEntity.ok(Map.of("message", "Stat 값이 변경되어 메시지가 발송되었습니다."));
        } else {
            return ResponseEntity.ok(Map.of("message", "Stat 값이 변경되지 않았습니다."));
        }
    }
    
    


}
