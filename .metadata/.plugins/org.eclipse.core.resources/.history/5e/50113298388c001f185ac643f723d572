package com.example.demo.Service;

import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Service;
import lombok.RequiredArgsConstructor;

@Service
@RequiredArgsConstructor
public class StatCheckService {

    private final StatRepository statRepository; // stat 값을 조회하기 위한 repository
    private final UserRepository userRepository; // 유저 정보 조회를 위한 repository
    private final PhoneService phoneService;     // 문자 발송을 위한 service

    @Scheduled(fixedRate = 300000) // 5분마다 실행
    public void checkStatAndSendSms() {
        // 예시로 stat의 id값을 "1"로 설정
        int statId = 1;

        // stat 값 조회
        StatEntity stat = statRepository.findById(statId).orElseThrow(() -> new IllegalArgumentException("Stat not found"));

        // stat 값이 2에서 3으로 변경되었는지 확인
        if ("2".equals(stat.getLastTsdt()) && "3".equals(stat.getStat())) {
            // username을 통해서 phone 조회
            String username = "exampleUser"; // 실제 username 받아오기
            UserEntity user = userRepository.findByUsername(username).orElseThrow(() -> new IllegalArgumentException("User not found"));
            String phoneNumber = user.getPhone();

            // 문자 발송
            phoneService.sendOne3(phoneNumber);
        }
    }
}